<?php

/*
 * Generated by `php artisan classroom:student-db install` and on every serve; changes are overwritten.
 *
 * Exchanges a token issued by the classroom app for a phpMyAdmin session in the
 * student's own MySQL account. Tokens live outside the web folder and expire
 * after a few minutes. The token file is kept until it expires, so a student
 * who reloads the page or opens the link in a second tab still gets in; the
 * app deletes expired tokens as it issues new ones.
 */

$token = (string) ($_GET['token'] ?? '');
// Found next to this copy (web/phpmyadmin -> tokens), so moving the project folder keeps working.
$file = dirname(__DIR__, 2).DIRECTORY_SEPARATOR.'tokens'.DIRECTORY_SEPARATOR.$token.'.json';
$data = preg_match('/^[A-Za-z0-9]{40}$/', $token) && is_file($file) ? json_decode((string) file_get_contents($file), true) : null;

if (! is_array($data) || ($data['expires'] ?? 0) <= time()
    || (! ($data['read_only'] ?? false) && is_file(dirname(__DIR__, 2).'/closed/'.basename($data['database'] ?? '').'.json'))) {
    http_response_code(403);
    header('Content-Type: text/html; charset=utf-8');
    exit('<!DOCTYPE html><title>Link expired</title><p style="font-family:sans-serif">This phpMyAdmin link has expired. Go back to your assessment and press <strong>Open phpMyAdmin</strong> again.</p>');
}

$path = rtrim(strtr(dirname($_SERVER['SCRIPT_NAME']), '\\', '/'), '/').'/';
session_name('CCISStudentDB');
session_set_cookie_params(['path' => $path, 'httponly' => true, 'samesite' => 'Lax']);
session_start();
session_regenerate_id(true);
$_SESSION['PMA_single_signon_user'] = $data['user'];
$_SESSION['PMA_single_signon_password'] = $data['password'];
$_SESSION['PMA_single_signon_host'] = '127.0.0.1';
session_write_close();

header('Location: index.php?route=/database/structure&db='.rawurlencode($data['database']));
