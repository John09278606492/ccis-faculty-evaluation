<?php

/*
 * Generated by `php artisan classroom:student-db install`; changes are overwritten.
 *
 * Students reach this phpMyAdmin only through one-time sign-on links from their
 * quiz (signon.php). It connects to the separate student MySQL server, never to
 * the classroom application's own database.
 */

$cfg['blowfish_secret'] = '{{blowfish_secret}}';

$i = 1;
$cfg['Servers'][$i]['auth_type'] = 'signon';
$cfg['Servers'][$i]['SignonSession'] = 'CCISStudentDB';
$cfg['Servers'][$i]['SignonURL'] = 'signed-out.html';
$cfg['Servers'][$i]['LogoutURL'] = 'signed-out.html';
$cfg['Servers'][$i]['host'] = '127.0.0.1';
$cfg['Servers'][$i]['port'] = '{{port}}';
$cfg['Servers'][$i]['compress'] = false;
$cfg['Servers'][$i]['AllowNoPassword'] = false;
$cfg['Servers'][$i]['hide_db'] = '^(information_schema|performance_schema|mysql|sys)$';

$cfg['AllowArbitraryServer'] = false;
$cfg['ShowServerInfo'] = false;
$cfg['ShowPhpInfo'] = false;
$cfg['ShowChgPassword'] = false;
$cfg['ShowCreateDb'] = true;
$cfg['VersionCheck'] = false;
$cfg['SendErrorReports'] = 'never';
$cfg['ShowGitRevision'] = false;
$cfg['ThemeManager'] = false;
$cfg['NavigationTreeEnableGrouping'] = false;
$cfg['LoginCookieValidity'] = 14400;
$cfg['ExecTimeLimit'] = 60;
$cfg['TempDir'] = __DIR__.'/tmp';
$cfg['UploadDir'] = '';
$cfg['SaveDir'] = '';
