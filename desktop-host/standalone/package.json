{
  "name": "ccis-classroom-standalone",
  "version": "2.0.0",
  "private": true,
  "description": "Self-contained CCIS classroom server with managed PHP and MySQL",
  "author": "CCIS",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:bundle": "node prepare.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win nsis --x64",
    "build:folder": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "edu.ccis.classroom.standalone",
    "productName": "CCIS Classroom",
    "files": [
      "main.cjs",
      "preload.cjs",
      "runtime.cjs",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "classroom"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "perMachine": true,
      "include": "installer.nsh"
    },
    "artifactName": "CCIS-Classroom-${version}-Windows-${arch}-Setup.${ext}"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}